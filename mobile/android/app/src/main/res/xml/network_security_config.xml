<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP stays blocked everywhere by default. The only exceptions are
  the loopback addresses a developer machine uses (10.0.2.2 is the Android
  emulator's alias for the host), so a local node can be tested without opening
  the app to plaintext traffic against real servers.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
