# Copy to deploy/.env.prod and fill in. Never commit the filled copy.
#
#   cp deploy/.env.prod.example deploy/.env.prod

# The hostname a phone will reach this node on. Its DNS A record must already
# point here, or Caddy cannot get a certificate.
AGRIN_DOMAIN=node.example.org

AGRIN_ENV=prod
NODE_ID=node-in
NODE_COUNTRY=IN

# Generate both, do not invent them by hand:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_USER=agrin
POSTGRES_DB=agrin

# Copernicus, for satellite crop health. Free: https://dataspace.copernicus.eu
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_MONTHLY_PU_CAP=9000

# Claude, for the cloud diagnosis fallback and plain-language advisories.
# Without it the node still works: on-device diagnosis answers about 44% of
# photos and advisories use the deterministic template.
ANTHROPIC_API_KEY=
CLAUDE_NARRATE_MODEL=claude-sonnet-5
CLAUDE_VISION_MODEL=claude-opus-5

# Set these at or below the credit actually on the account. A cap above the
# balance is not a cap -- the account runs dry first, and every call then fails
# as "the cloud is unavailable" with nothing saying why.
LLM_MONTHLY_USD_CAP=25
LLM_DAILY_CALLS_PER_USER=20

# SMS. The console gateway refuses to run outside development, so this MUST be
# set before real farmers are enrolled or nobody can sign in.
SMS_PROVIDER=
SMS_BRAND=AgriN
