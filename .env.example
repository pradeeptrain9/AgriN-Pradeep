# --- Core ---
AGRIN_ENV=dev
NODE_ID=node-in
NODE_COUNTRY=IN
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
DATABASE_URL=postgresql+asyncpg://agrin:agrin@localhost:5433/agrin
REDIS_URL=redis://localhost:6380

# --- Copernicus Data Space (Sentinel Hub) ---
# Register free: https://dataspace.copernicus.eu  -> User Settings -> OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Free tier: 10,000 processing units / month, resets 1st, no carryover.
CDSE_MONTHLY_PU_CAP=9000

# --- Anthropic ---
# From https://console.anthropic.com -> Settings -> API keys. Billing must be
# enabled on the org; a key alone does not grant credit.
# Without it the node still works: on-device diagnosis answers ~44% of photos,
# the rest return "inconclusive", and advisories use the built-in template.
ANTHROPIC_API_KEY=

# Hard ceilings. The monthly cap is what makes a stated running cost true; the
# per-user daily cap stops one handset draining the month. Reaching either
# degrades to on-device and template only -- never an error.
# Narration rephrases only, and the guard catches invented figures mechanically,
# so a mid-tier model is the right default here. Vision is different: there the
# model IS the answer and nothing downstream can check it -- keep it on opus.
CLAUDE_NARRATE_MODEL=claude-sonnet-5
CLAUDE_VISION_MODEL=claude-opus-5

LLM_MONTHLY_USD_CAP=25
LLM_DAILY_CALLS_PER_USER=20

# --- Open-Meteo / SoilGrids need no keys ---
SOILGRIDS_RATE_PER_MIN=5

# --- SMS. Without this nobody can sign in. See docs/DEPLOYMENT.md.
# console | twilio | webhook. console refuses to run outside dev.
SMS_PROVIDER=console
SMS_BRAND=AgriN

# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# webhook: any aggregator, configured rather than coded.
# {phone} and {message} are substituted into the payload.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_METHOD=POST
SMS_WEBHOOK_CONTENT_TYPE=form
SMS_WEBHOOK_PAYLOAD=
SMS_WEBHOOK_HEADERS=
SMS_WEBHOOK_SUCCESS_FIELD=
# India: the DLT-registered template id the delivered text must match.
SMS_TEMPLATE_ID=
